# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vaani_ai
JWT_SECRET=your_secure_jwt_secret_here

# Official Gnani.ai API Credentials
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_API_KEY=your_gnani_stt_key_here
GNANI_TTS_API_KEY=your_gnani_tts_key_here

# Official Gnani.ai Endpoints
GNANI_STT_BASE_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_BASE_URL=https://api.vachana.ai/api/v1/tts/inference

# Frontend URL for CORS
CLIENT_ORIGIN=http://localhost:5173
